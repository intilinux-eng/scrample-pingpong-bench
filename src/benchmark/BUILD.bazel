load("@rules_cc//cc:defs.bzl", "cc_binary")

# Ping-pong latency / jitter / throughput benchmark for score::mw::com.
#
# This package also works unchanged inside a fork of eclipse-score/scrample. There, add this line
# to MODULE.bazel first (scrample does not depend on Google Benchmark):
#
#   bazel_dep(name = "google_benchmark", version = "1.9.5", repo_name = "com_github_google_benchmark")
#
# Build:  bazel build --config=host -c opt //src/benchmark:score_pingpong_bench
# Run:    src/benchmark/run_benchmark.sh

filegroup(
    name = "mw_com_config",
    srcs = ["etc/mw_com_config.json"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "score_pingpong_bench",
    srcs = ["pingpong_bench.cpp"],
    data = [":mw_com_config"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_google_benchmark//:benchmark",
        "@score_communication//score/mw/com",
    ],
)
