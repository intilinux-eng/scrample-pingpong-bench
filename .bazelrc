# The S-CORE registry is listed first so that its modules win over the Bazel Central Registry.
common --registry=https://raw.githubusercontent.com/eclipse-score/bazel_registry/main/
common --registry=https://bcr.bazel.build

# Feature flags the S-CORE modules need on a plain Linux host (same set as eclipse-score/scrample).
build:_common --@score_baselibs//score/mw/log/flags:KRemote_Logging=False
build:_common --@score_baselibs//score/json:base_library=nlohmann
build:_common --@score_baselibs//score/memory/shared/flags:use_typedshmd=False
build:_common --@score_communication//score/mw/com/flags:tracing_library=stub
build:_common --cxxopt=-Wno-error=mismatched-new-delete
build:_common --cxxopt=-Wno-error=deprecated-declarations

# Always build with --config=host. Without it the flags above are missing and the build fails.
build:host --config=_common

# Upstream compiles its sources with -Werror. With -c opt, GCC 13 reports a flow-analysis false
# positive in score/memory/shared/offset_ptr.h that an unoptimised build (what scrample uses) does
# not. Keep it a warning so the optimised build that a benchmark needs goes through.
build:host --cxxopt=-Wno-error=maybe-uninitialized

# Optional, untracked per-user settings.
try-import %workspace%/user.bazelrc
