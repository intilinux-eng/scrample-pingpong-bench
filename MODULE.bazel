# S-CORE versions follow the platform release v0.10.0 of eclipse-score/reference_integration
# (known_good.json: score_communication 0.6.0, score_baselibs 0.2.17), reduced to what the
# benchmark needs. scrample still pins the older v0.5.0-alpha set.
module(
    name = "score_pingpong_bench",
    version = "0.1.0",
)

# The versions below are the ones score_communication 0.6.0 resolves to. Declaring lower ones
# would only produce "root module requires ... but got ..." warnings.
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")

# Python toolchain used by build-time tooling of the S-CORE modules.
bazel_dep(name = "rules_python", version = "1.8.5")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# Google Benchmark. The repo_name keeps the conventional @com_github_google_benchmark label.
bazel_dep(name = "google_benchmark", version = "1.9.5", repo_name = "com_github_google_benchmark")

# Eclipse S-CORE. score_communication provides score::mw::com.
bazel_dep(name = "score_baselibs", version = "0.2.17")
bazel_dep(name = "score_communication", version = "0.6.0")

# score_communication depends on the two modules below without a registry version.
# Overrides are only honoured in the root module, so they have to be repeated here.
bazel_dep(name = "rules_boost", repo_name = "com_github_nelhage_rules_boost")
archive_override(
    module_name = "rules_boost",
    strip_prefix = "rules_boost-master",
    urls = ["https://github.com/nelhage/rules_boost/archive/refs/heads/master.tar.gz"],
)

# Same commit as reference_integration v0.10.0. score_tooling 3.x (pulled in by
# score_communication 0.6.0) loads subrule_trlc_image_stage, which trlc 2.0.2 does not have.
bazel_dep(name = "trlc", version = "0.0.0")
git_override(
    module_name = "trlc",
    commit = "8d25f639ff44976893d7866ba421a04db5698ebe",
    remote = "https://github.com/bmw-software-engineering/trlc.git",
)
